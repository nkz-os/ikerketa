# IkerKeta Environment Configuration
# Copy to .env and fill in real values

# EPPO Global Database API Token (request at https://data.eppo.int)
EPPO_API_TOKEN=

# AGROVOC SPARQL Endpoint (public, no auth)
AGROVOC_SPARQL_ENDPOINT=https://agrovoc.fao.org/sparql

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Data directories
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_REPORTS_DIR=data/reports
